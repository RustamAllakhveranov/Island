<?xml version="1.0" encoding="UTF-8" ?>
<Configuration status="TRACE" name="island" packages="">
    <Appenders>
        <File name="FileLogger"
              fileName="logs/island.log"
              append="false">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p %c{1} [%t] %m%n</Pattern>
            </PatternLayout>
        </File>
        <Async name="AsyncFileLogger">
            <AppenderRef ref="FileLogger"/>
        </Async>
    </Appenders>
    <Loggers>
        <Root level="info" additivity="false">
            <AppenderRef ref="AsyncFileLogger"/>
        </Root>
    </Loggers>
</Configuration>